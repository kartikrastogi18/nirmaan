FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-hex-value
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-hex-value

# Shared internet database (required for deployed multi-user sync)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Development defaults to local private media storage.
STORAGE_BACKEND=local
UPLOAD_ROOT=

# For deployed shared photos / voice notes / files, use private S3-compatible storage.
# Cloudflare R2 example: STORAGE_BACKEND=s3 and endpoint https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional for a small personal deployment. memory:// is fine for a single web process.
RATELIMIT_STORAGE_URI=memory://
